{
  "entity": {
    "sensor": {
      "last_performed": {
        "default": "mdi:calendar-check"
      },
      "next_due": {
        "default": "mdi:calendar-clock"
      },
      "remaining": {
        "default": "mdi:timer-sand"
      },
      "hours_left": {
        "default": "mdi:timer-outline"
      },
      "lifespan": {
        "default": "mdi:timer-cog-outline"
      },
      "interval": {
        "default": "mdi:calendar-refresh"
      }
    },
    "button": {
      "mark_done": {
        "default": "mdi:check-circle-outline"
      }
    }
  },
  "services": {
    "reset_last_performed": {
      "service": "mdi:check-circle-outline"
    },
    "send_notifications": {
      "service": "mdi:bell-ring-outline"
    }
  }
}
